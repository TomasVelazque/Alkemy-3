      "name": "Categorias",
      "item": [
        {
          "name": "Listar todas las categorias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is a JSON array\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Array is not empty\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.length).to.be.greaterThan(0);\r\n});\r\n\r\npm.test(\"Each category has required fields\", function () {\r\n    const json = pm.response.json();\r\n    json.forEach(function (category) {\r\n        pm.expect(category).to.have.property(\"id\");\r\n        pm.expect(category).to.have.property(\"nombre_categoria\");\r\n        pm.expect(category).to.have.property(\"descripcion_categoria\");\r\n        pm.expect(category).to.have.property(\"created_at\");\r\n        pm.expect(category).to.have.property(\"updated_at\");\r\n    });\r\n});\r\n\r\npm.test(\"Category id is a number\", function () {\r\n    const json = pm.response.json();\r\n    json.forEach(function (category) {\r\n        pm.expect(category.id).to.be.a(\"number\");\r\n    });\r\n});\r\n\r\npm.test(\"Category nombre_categoria is a non-empty string\", function () {\r\n    const json = pm.response.json();\r\n    json.forEach(function (category) {\r\n        pm.expect(category.nombre_categoria).to.be.a(\"string\").and.not.empty;\r\n    });\r\n});\r\n\r\npm.test(\"Response time is less than 2000ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});"
                ]
              }
            }
          ],
